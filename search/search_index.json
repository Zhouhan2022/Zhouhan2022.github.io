{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e3b\u9875","text":"\u8df3\u6ce2\u8001\u9c7c\u7f38"},{"location":"#_1","title":"\ud83d\udee0 \u7ba1\u7406\u5165\u53e3\uff08\u7ad9\u4e3b\u4f7f\u7528\uff09","text":"<ul> <li>\u6539\u6587\u6bb5\uff1a\u6253\u5f00\u4efb\u610f\u9875\u9762\uff0c\u70b9\u53f3\u4e0a\u89d2\u7684 \u270f\ufe0f \u56fe\u6807 \u2192 \u5728 GitHub \u7f51\u9875\u7f16\u8f91\u5668\u91cc\u76f4\u63a5\u589e\u5220\u6587\u5b57 \u2192 \u63d0\u4ea4\uff0c\u7f51\u7ad9\u81ea\u52a8\u66f4\u65b0</li> <li>\u65b0\u5efa\u9875\u9762\uff1a\u2795 \u65b0\u5efa\u9875\u9762</li> <li>\u5220\u9664\u9875\u9762\uff1a\ud83d\uddc2 \u7ba1\u7406\u9875\u9762 \u2192 \u70b9\u8fdb\u8981\u5220\u7684\u6587\u4ef6 \u2192 \u53f3\u4e0a\u89d2\u5783\u573e\u6876\u56fe\u6807\u5220\u9664</li> <li>\u26a0\ufe0f \u65b0\u5efa/\u5220\u9664\u9875\u9762\u540e\uff0c\u8fd8\u8981\u5230 mkdocs.yml \u7684 <code>nav</code> \u91cc\u52a0/\u5220\u4e00\u884c\uff0c\u4fa7\u8fb9\u680f\u624d\u4f1a\u663e\u793a\uff08\u5426\u5219\u9875\u9762\u5b58\u5728\u4f46\u5bfc\u822a\u91cc\u770b\u4e0d\u5230\uff09</li> </ul>"},{"location":"about/","title":"\u5173\u4e8e","text":"<p>\u4f60\u597d\uff0c\u6b22\u8fce\u6765\u5230\u300c\u8df3\u6ce2\u8001\u9c7c\u7f38\u300d\u3002</p> <p>\u8fd9\u91cc\u662f\u6211\u968f\u4fbf\u8bb0\u5f55\u4e00\u4e9b\u4e1c\u897f\u7684\u5730\u65b9\uff0c\u4e0d\u4fdd\u8bc1\u66f4\u65b0\u9891\u7387\uff0c\u4e0d\u4fdd\u8bc1\u5185\u5bb9\u8d28\u91cf\u3002</p>"},{"location":"about/#_2","title":"\u8054\u7cfb\u65b9\u5f0f","text":"<ul> <li>\u90ae\u7bb1\uff1ame@example.com\uff08\u793a\u4f8b\u5360\u4f4d\uff0c\u8bb0\u5f97\u6539\u6210\u4f60\u81ea\u5df1\u7684\uff09</li> </ul>"},{"location":"about/#_3","title":"\u5173\u4e8e\u672c\u7ad9","text":"<p>\u4f7f\u7528 MkDocs + Material \u4e3b\u9898 \u642d\u5efa\u3002</p>"},{"location":"course/","title":"\u95f2\u6742","text":"<p>\u968f\u4fbf\u5199\u5199\uff0c\u4ec0\u4e48\u90fd\u53ef\u80fd\u6709\u3002</p>"},{"location":"course/#_2","title":"\u6587\u7ae0\u5217\u8868","text":"<ul> <li>\u793a\u4f8b\u6587\u7ae0 \u2014\u2014 \u6211\u5199\u7684\u7b2c\u4e00\u7bc7\u4e1c\u897f</li> </ul>"},{"location":"course/canvas-demo/","title":"\u753b\u5e03\u6f14\u793a","text":"<p>\u8fd9\u4e2a\u9875\u9762\u6f14\u793a\u4e09\u4ef6\u4e8b\uff1a\u6587\u5b57\u8bb0\u5f55\u3001\u53ef\u70b9\u51fb\u7684\u8d85\u94fe\u63a5\u3001\u884c\u6587 \u21c4 \u753b\u5e03 \u4e24\u79cd\u5e03\u5c40\u5207\u6362\u3002</p>"},{"location":"course/canvas-demo/#_2","title":"\u8d85\u94fe\u63a5\u6f14\u793a","text":"<ul> <li>\u5916\u90e8\u94fe\u63a5\uff1aMkDocs \u5b98\u7f51\uff08\u70b9\u4e00\u4e0b\u5728\u65b0\u9875\u9762\u6253\u5f00\uff09</li> <li>\u7ad9\u5185\u94fe\u63a5\uff1a\u5173\u4e8e\u6211\uff08\u8df3\u5230\u540c\u7ad9\u7684\u53e6\u4e00\u9875\uff09</li> <li>\u540c\u9875\u951a\u70b9\uff1a\u76f4\u63a5\u8df3\u5230\u4e0b\u9762\u7684\u753b\u5e03\uff08\u5c0f\u6280\u5de7\uff1a\u4e2d\u6587\u6807\u9898\u7684\u951a\u70b9\u4f1a\u81ea\u52a8\u7f16\u53f7\u6210 _3\uff09</li> </ul>"},{"location":"course/canvas-demo/#_3","title":"\u753b\u5e03\u5c0f\u8282","text":"<p>\u4e0b\u9762\u8fd9\u4e00\u5c0f\u8282\u9ed8\u8ba4\u6309\"\u884c\u6587\"\u6392\u7248\uff1b\u70b9 \ud83d\uddbc \u753b\u5e03 \u4f1a\u5207\u6210\u4e00\u5f20\"\u7eb8\"\uff0c\u4e0a\u9762\u53ef\u4ee5\u81ea\u7531\u6446\u653e\u6587\u5b57\uff08\u9ed8\u8ba4\u65e0\u8fb9\u6846\uff09\u548c\u56fe\u7247\uff0c\u6587\u5b57/\u56fe\u7247\u90fd\u80fd\u62d6\u52a8\u3001\u7f29\u653e\u3002</p> <ul> <li>\ud83d\udcc4 \u884c\u6587 = \u7ebf\u6027\u9605\u8bfb\u7248\uff08\u624b\u673a/\u6253\u5370/\u590d\u5236\u7528\uff09\uff0c\u987a\u5e8f = \u6570\u636e\u91cc\u7684\u5148\u540e\u987a\u5e8f</li> <li>\ud83d\udccd \u6309\u4f4d\u7f6e\u6392\u5e8f = \u628a\u753b\u5e03\u4e0a\u7684\u5b9e\u9645\u4f4d\u7f6e\u53d8\u6210\u884c\u6587\u987a\u5e8f\uff08\u5148\u4e0a\u540e\u4e0b\u3001\u540c\u9ad8\u5148\u5de6\u540e\u53f3\uff09</li> <li>\u270f\ufe0f \u7f16\u8f91\u6a21\u5f0f = \u62d6\u52a8\u3001\u53f3\u4e0b\u89d2\u62c9\u5927\u5c0f\u3001\u53cc\u51fb\u6539\u5b57\u3001\u00d7 \u5220\u9664\u3001\uff0b\u6587\u5b57/\uff0b\u56fe\u7247</li> <li>\u2b07 \u5bfc\u51faJSON = \u6539\u5b8c\u5bfc\u51fa\uff0c\u628a\u6570\u7ec4\u8d34\u56de\u672c\u9875\u6e90\u7801\u7684 <code>&lt;script&gt;</code> \u91cc</li> </ul> <p>\u63d0\u793a\uff1a\u7f16\u8f91\u6a21\u5f0f\u4e0b\u628a\u6587\u5b57/\u56fe\u7247\u62d6\u5230\u559c\u6b22\u7684\u4f4d\u7f6e\uff0c\u70b9\"\u5bfc\u51faJSON\"\uff0c\u628a\u5bfc\u51fa\u7684\u6570\u7ec4\u66ff\u6362\u5230\u672c\u9875\u7684 <code>&lt;script&gt;</code> \u91cc\uff0c\u63d0\u4ea4\u540e\u5168\u7ad9\u751f\u6548\u3002</p>"},{"location":"course/canvas-demo/#_4","title":"\u7ad9\u5185\u7f16\u8f91","text":"<p>\u6bcf\u9875\u53f3\u4e0a\u89d2\uff08\u7f16\u8f91\u672c\u9875\u94c5\u7b14\u65c1\u8fb9\uff09\u591a\u4e86\u4e00\u4e2a \u270f\ufe0f \u7ad9\u5185\u7f16\u8f91 \u6309\u94ae\uff1a\u6253\u5f00\u540e\u5de6\u8fb9\u662f\u8fd9\u4e00\u9875\u7684 Markdown \u539f\u6587\uff0c\u53f3\u8fb9\u53ef\u4ee5\u5f00\u5173\u9884\u89c8\u3002\u9884\u89c8\u5f00\u5173\u9ed8\u8ba4\u5173\u95ed\uff0c\u6253\u5f00\u540e\u624d\u5b9e\u65f6\u6e32\u67d3\uff0c\u907f\u514d\u6d6a\u8d39\u8d44\u6e90\u3002\u6539\u5b8c\u590d\u5236\u6216\u4e0b\u8f7d\uff0c\u518d\u53bb GitHub \u63d0\u4ea4\u3002</p>"},{"location":"course/example/","title":"\u8fd9\u662f\u4e00\u7bc7\u793a\u4f8b\u6587\u7ae0","text":"<p>2025\u5e741\u67081\u65e5</p>"},{"location":"course/example/#_2","title":"\u8fd9\u662f\u5927\u6807\u9898","text":"<p>\u6b63\u6587\u5199\u5728\u8fd9\u91cc\u3002\u60f3\u5206\u6bb5\u7684\u8bdd\uff0c\u4e2d\u95f4\u7a7a\u4e00\u884c\u5c31\u884c\u3002</p>"},{"location":"course/example/#_3","title":"\u518d\u4e00\u4e2a\u5927\u6807\u9898","text":"<p>\u7ee7\u7eed\u5199\u6b63\u6587\u3002\u8fd9\u662f\u52a0\u7c97\u7684\u6587\u5b57\uff0c\u8fd9\u662f\u659c\u4f53\u3002</p>"},{"location":"course/example/#_4","title":"\u4e5f\u53ef\u4ee5\u6709\u5c0f\u6807\u9898","text":"<p>\u8fd9\u662f\u4e00\u6bb5\u5f15\u7528\u6587\u5b57\u3002</p> <ul> <li>\u8fd9\u662f\u5217\u8868\u7b2c\u4e00\u9879</li> <li>\u8fd9\u662f\u5217\u8868\u7b2c\u4e8c\u9879</li> <li>\u8fd9\u662f\u5217\u8868\u7b2c\u4e09\u9879</li> </ul>"},{"location":"course/example/#_5","title":"\u63d2\u5165\u94fe\u63a5","text":"<p>\u70b9\u8fd9\u91cc\u53bb\u8c37\u6b4c</p>"},{"location":"course/example/#_6","title":"\u63d2\u5165\u56fe\u7247","text":"<p>\u4e00\u5f20\u968f\u673a\u7684\u793a\u4f8b\u56fe\u7247\u3002</p> <p>\u5b8c\u3002</p>"},{"location":"friends/","title":"\u53cb\u94fe","text":"<p>\u4e00\u4e9b\u670b\u53cb\u7684\u7f51\u7ad9\u3002</p> <ul> <li>\u793a\u4f8b\u670b\u53cb A \u2014\u2014 \u8fd9\u662f\u4e2a\u793a\u4f8b\u5360\u4f4d\u94fe\u63a5</li> <li>\u793a\u4f8b\u670b\u53cb B \u2014\u2014 \u8fd9\u4e5f\u662f\u4e2a\u793a\u4f8b\u5360\u4f4d\u94fe\u63a5</li> </ul> <p>\u4ee5\u540e\u6709\u4e86\u771f\u6b63\u7684\u670b\u53cb\u94fe\u63a5\uff0c\u6765\u8fd9\u91cc\u66ff\u6362\u6389\u5c31\u597d\u3002</p>"},{"location":"page-mws51qx6/","title":"\u8bd5\u8bd5\u770b","text":"<p>\uff08\u5185\u5bb9\u5f85\u5199\uff09</p>"}]}